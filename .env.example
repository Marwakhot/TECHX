# Copy to .env and fill in. Never commit .env.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash-lite
# PIN the Operations Controller types to approve gate/schedule/crew changes. Approvals are refused if empty.
OCC_CONTROLLER_PIN=
AVIANT_DB=aviant.sqlite
# Autonomous agent (optional; defaults shown)
AGENT_ENABLED=1
AGENT_INTERVAL_S=30
AGENT_COOLDOWN_S=20
AGENT_MAX_REPLANS_PER_TICK=4
# Only if a separate front end (e.g. Vercel) proxies /api to this server: comma-separated origins allowed to POST
ALLOWED_ORIGINS=
